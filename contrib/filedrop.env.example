# /etc/filedrop.env, read by the systemd unit and by the `filedrop` command wrapper.

# Address senders use. Required.
FILEDROP_PUBLIC_URL=https://drop.example.com

# Finished files land in one folder per link below this directory.
FILEDROP_DIR=/srv/filedrop

# If FILEDROP_DIR lives on a network or removable mount, name the mount point here:
# uploads are refused while it is not mounted, so they can never fill the local disk.
#FILEDROP_MOUNT=/mnt/storage

# Never let an upload take free space below this.
#FILEDROP_MIN_FREE=10G

# Forget finished, revoked and expired links after this many days (files are kept). 0 = never.
#FILEDROP_KEEP_DAYS=30

#FILEDROP_STATE=/var/lib/filedrop/tokens.json
#FILEDROP_LISTEN=127.0.0.1:8099
